<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.flowcatalyst.framework</groupId>
  <artifactId>framework-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>framework-parent</name>
  <description>Application framework for business services: parent build.</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <url>https://github.com/flowcatalyst/framework</url>

  <scm>
    <url>https://github.com/flowcatalyst/framework</url>
    <connection>scm:git:https://github.com/flowcatalyst/framework.git</connection>
    <developerConnection>scm:git:git@github.com:flowcatalyst/framework.git</developerConnection>
  </scm>

  <!-- GitHub Packages (MA item 1). Credentials are never in the repository: the server id 'github'
       is given by the publish workflow (GITHUB_TOKEN) or a developer's settings.xml. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages: flowcatalyst/framework</name>
      <url>https://maven.pkg.github.com/flowcatalyst/framework</url>
    </repository>
  </distributionManagement>

  <modules>
    <module>framework-bom</module>
    <module>framework-core</module>
    <module>framework-database</module>
    <module>framework-redis</module>
    <module>framework-locks</module>
    <module>framework-locks-database</module>
    <module>framework-locks-redis</module>
    <module>framework-usecase</module>
    <module>framework-http</module>
    <module>framework-http-jetty</module>
    <module>framework-ratelimit-redis</module>
    <module>framework-httpclient</module>
    <module>framework-httpclient-module</module>
    <module>framework-admin</module>
    <module>framework-flowcatalyst</module>
    <module>framework-auth</module>
    <module>framework-auth-database</module>
    <module>framework-auth-redis</module>
    <module>framework-ui</module>
    <module>framework-sql</module>
    <module>framework-sql-maven-plugin</module>
    <module>examples/locks-demo</module>
    <module>examples/orders-demo</module>
    <module>examples/orders-demo-jte</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-10-08T00:00:00Z</project.build.outputTimestamp>

    <!-- build -->
    <maven-api.version>3.9.13</maven-api.version>
    <maven-plugin-tools.version>3.15.2</maven-plugin-tools.version>
    <errorprone.version>2.50.0</errorprone.version>
    <nullaway.version>0.14.2</nullaway.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
  </properties>

  <!-- Every version of a framework artifact and of a library lives in framework-bom (MA item 1);
       the parent imports it, exactly as an application does. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module: nullness annotations, the logging API, and the test stack. -->
  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
        </plugin>
        <!-- A module that lists this plugin gets the HTTP-only classpath rule (MA item 8): an
             application using only HTTP must not get the write path, the database module, HikariCP
             or the PostgreSQL driver, in any scope, directly or transitively. -->
        <plugin>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>http-only-classpath</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <bannedDependencies>
                    <searchTransitive>true</searchTransitive>
                    <excludes>
                      <exclude>io.flowcatalyst.framework:framework-usecase</exclude>
                      <exclude>io.flowcatalyst.framework:framework-database</exclude>
                      <exclude>com.zaxxer:HikariCP</exclude>
                      <exclude>org.postgresql:postgresql</exclude>
                    </excludes>
                    <message>framework-http must depend on framework-core only (MA item 8): no write path, database module, HikariCP or PostgreSQL driver.</message>
                  </bannedDependencies>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <showWarnings>true</showWarnings>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-Xlint:all,-processing</arg>
                <arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=io.flowcatalyst.framework -XepOpt:NullAway:JSpecifyMode=true</arg>
              </compilerArgs>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-Xlint:all,-processing</arg>
                <!-- Error Prone runs on tests; NullAway does not (test fixtures use late-initialised fields). -->
                <arg>-Xplugin:ErrorProne -Xep:NullAway:OFF</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- -Prelease: what the publish workflow deploys adds a sources jar to every jar module. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

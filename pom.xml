<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.flowcatalyst.framework</groupId>
  <artifactId>framework-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>framework-parent</name>
  <description>Application framework for business services: parent build.</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>framework-core</module>
    <module>framework-database</module>
    <module>framework-redis</module>
    <module>framework-locks</module>
    <module>framework-locks-database</module>
    <module>framework-locks-redis</module>
    <module>framework-usecase</module>
    <module>framework-http</module>
    <module>framework-http-jetty</module>
    <module>framework-flowcatalyst</module>
    <module>framework-sql</module>
    <module>framework-sql-maven-plugin</module>
    <module>examples/locks-demo</module>
    <module>examples/orders-demo</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-10-08T00:00:00Z</project.build.outputTimestamp>

    <!-- libraries -->
    <jspecify.version>1.0.1</jspecify.version>
    <slf4j.version>2.0.20</slf4j.version>
    <snakeyaml-engine.version>3.2</snakeyaml-engine.version>
    <hikaricp.version>7.1.0</hikaricp.version>
    <postgresql.version>42.7.14</postgresql.version>
    <jedis.version>8.0.2</jedis.version>
    <jackson.version>3.2.3</jackson.version>
    <jetty.version>12.1.12</jetty.version>

    <!-- test -->
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <flowcatalyst-sdk.version>0.0.11</flowcatalyst-sdk.version>

    <!-- build -->
    <maven-api.version>3.9.13</maven-api.version>
    <maven-plugin-tools.version>3.15.2</maven-plugin-tools.version>
    <errorprone.version>2.50.0</errorprone.version>
    <nullaway.version>0.14.2</nullaway.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-database</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-database</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-redis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-redis</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks-database</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks-redis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-usecase</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-http</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-http-jetty</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-sql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-flowcatalyst</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-flowcatalyst</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.snakeyaml</groupId>
        <artifactId>snakeyaml-engine</artifactId>
        <version>${snakeyaml-engine.version}</version>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${hikaricp.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>redis.clients</groupId>
        <artifactId>jedis</artifactId>
        <version>${jedis.version}</version>
      </dependency>

      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-server</artifactId>
        <version>${jetty.version}</version>
      </dependency>
      <!-- The FlowCatalyst SDK. Compile dependency of framework-flowcatalyst only; framework-usecase
           uses it in test scope, to prove outbox payloads are what it writes. -->
      <dependency>
        <groupId>io.flowcatalyst</groupId>
        <artifactId>flowcatalyst-sdk</artifactId>
        <version>${flowcatalyst-sdk.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module: nullness annotations, the logging API, and the test stack. -->
  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <showWarnings>true</showWarnings>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-Xlint:all,-processing</arg>
                <arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=io.flowcatalyst.framework -XepOpt:NullAway:JSpecifyMode=true</arg>
              </compilerArgs>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-Xlint:all,-processing</arg>
                <!-- Error Prone runs on tests; NullAway does not (test fixtures use late-initialised fields). -->
                <arg>-Xplugin:ErrorProne -Xep:NullAway:OFF</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

package kit

import (
	"regexp"
	"strconv"
	"strings"
	"time"

	"github.com/flowcatalyst/framework/go/ui/i18n"
)

// LocalTimeProps mirrors local-time.md's Props table.
type LocalTimeProps struct {
	// At is the instant; the zero time renders Empty.
	At       time.Time `json:"at"`
	DateOnly bool      `json:"dateOnly"`
	// Empty is the text for a zero At (default "-").
	Empty string `json:"empty"`
}

// localeExpr is the language the browser formats with: the page's (<html lang>, the
// locale the server resolved), else its own default.
const localeExpr = "document.documentElement.lang || undefined"

// The Local* components share one structure (local-time.md, Behaviour): the
// text sits in a data-ignore-morph span, which a morph that keeps the element
// leaves alone, and data-init names the value itself, so a morph that changes
// the value changes the attribute and Datastar runs it again. Every value put
// into an expression is checked first (an RFC 3339 instant, a plain decimal, a
// currency code), so it needs no escaping inside the quotes.
const localTextTarget = "el.firstElementChild.textContent = "

// datetime is the <time datetime> value: UTC, whole seconds, RFC 3339.
func (p LocalTimeProps) datetime() string {
	return p.At.UTC().Truncate(time.Second).Format(time.RFC3339)
}

func (p LocalTimeProps) expr() string {
	fn := "toLocaleString"
	if p.DateOnly {
		fn = "toLocaleDateString"
	}
	return localTextTarget + "new Date('" + p.datetime() + "')." + fn + "(" + localeExpr + ")"
}

// fallback is the UTC text shown before (or without) the localisation.
func (p LocalTimeProps) fallback() string {
	if p.DateOnly {
		return p.At.UTC().Format(time.DateOnly)
	}
	return p.At.UTC().Format(time.DateTime) + " UTC"
}

// LocalTime is local-time.md: a UTC instant the browser rewrites in the
// viewer's locale and time zone.
templ LocalTime(p LocalTimeProps) {
	if p.At.IsZero() {
		{ orDefault(p.Empty, "-") }
	} else {
		<time datetime={ p.datetime() } data-init={ p.expr() }><span data-ignore-morph>{ p.fallback() }</span></time>
	}
}

// DateRangeProps mirrors date-range.md's Props table.
type DateRangeProps struct {
	// ID derives the parts: {id}-label, {id}-from, {id}-to.
	ID        string           `json:"id"`
	Label     string           `json:"label"`
	FromName  string           `json:"fromName"`
	ToName    string           `json:"toName"`
	From      string           `json:"from"`
	To        string           `json:"to"`
	FromLabel string           `json:"fromLabel"`
	ToLabel   string           `json:"toLabel"`
	Attrs     templ.Attributes `json:"attrs"`
}

// boundExpr re-reads the other input's value into this one's bound on focus
// (date-range.md, Behaviour b).
func boundExpr(bound, otherID string) string {
	return "el." + bound + " = document.getElementById('" + ID(otherID) + "').value"
}

// DateRange is date-range.md: a whole-day range as two native date inputs.
templ DateRange(p DateRangeProps) {
	<div id={ ID(p.ID) } class="fc-form-field" role="group" aria-labelledby={ p.ID + "-label" }>
		<span id={ p.ID + "-label" } class="fc-field-label">{ p.Label }</span>
		<div class="flex items-center gap-2">
			<input
				type="date"
				id={ p.ID + "-from" }
				name={ orDefault(p.FromName, "from") }
				class="fc-input min-w-0 flex-1"
				aria-label={ orDefault(p.FromLabel, i18n.T(ctx, "kit.date_range.from")) }
				if p.From != "" {
					value={ p.From }
				}
				if p.To != "" {
					max={ p.To }
				}
				data-on:focus={ boundExpr("max", p.ID+"-to") }
				{ Attrs(p.Attrs)... }
			/>
			<span class="text-muted-foreground" aria-hidden="true">–</span>
			<input
				type="date"
				id={ p.ID + "-to" }
				name={ orDefault(p.ToName, "to") }
				class="fc-input min-w-0 flex-1"
				aria-label={ orDefault(p.ToLabel, i18n.T(ctx, "kit.date_range.to")) }
				if p.To != "" {
					value={ p.To }
				}
				if p.From != "" {
					min={ p.From }
				}
				data-on:focus={ boundExpr("min", p.ID+"-from") }
				{ Attrs(p.Attrs)... }
			/>
		</div>
	</div>
}

// plainDecimal is the value the Local* components accept: "-?[0-9]+(.[0-9]+)?".
var plainDecimal = regexp.MustCompile(`^-?[0-9]+(\.[0-9]+)?$`)

// maxFractionDigits is the most fraction digits a number is formatted with
// (the browsers' common limit for Intl.NumberFormat).
const maxFractionDigits = 20

// fractionDigits is the number of fraction digits of a plain decimal. It panics
// for text that is not one, or that has too many digits (local-number.md).
func fractionDigits(component, value string) int {
	if !plainDecimal.MatchString(value) {
		panic("kit: " + component + ": " + strconv.Quote(value) + " is not a plain decimal (-?[0-9]+(.[0-9]+)?)")
	}
	_, frac, _ := strings.Cut(value, ".")
	if len(frac) > maxFractionDigits {
		panic("kit: " + component + ": more than " + strconv.Itoa(maxFractionDigits) + " fraction digits")
	}
	return len(frac)
}

func digitsOptions(n int) string {
	d := strconv.Itoa(n)
	return "minimumFractionDigits: " + d + ", maximumFractionDigits: " + d
}

// numberFormatExpr builds the data-init expression around an Intl.NumberFormat
// call; value is a checked plain decimal.
func numberFormatExpr(options, value string) string {
	return localTextTarget + "new Intl.NumberFormat(" + localeExpr + ", {" + options + "}).format('" + value + "')"
}

// LocalNumberProps mirrors local-number.md's Props table.
type LocalNumberProps struct {
	// Value is plain decimal text; empty renders Empty.
	Value string `json:"value"`
	Empty string `json:"empty"`
}

// LocalNumber is local-number.md: a decimal the browser writes in the page's
// language; the server-rendered text is the plain value.
templ LocalNumber(p LocalNumberProps) {
	if p.Value == "" {
		{ orDefault(p.Empty, "-") }
	} else {
		<data value={ p.Value } data-init={ numberFormatExpr(digitsOptions(fractionDigits("LocalNumber", p.Value)), p.Value) }><span data-ignore-morph>{ p.Value }</span></data>
	}
}

// LocalMoneyProps mirrors local-money.md's Props table. The amount and the
// currency are plain strings, so the component depends on no money type.
type LocalMoneyProps struct {
	// Amount is plain decimal text; empty renders Empty.
	Amount string `json:"amount"`
	// Currency is the ISO 4217 code, three capital letters.
	Currency string `json:"currency"`
	// Digits, when set, is the fraction digits shown; absent, the currency's
	// own minor units.
	Digits *int   `json:"digits"`
	Empty  string `json:"empty"`
}

var currencyCode = regexp.MustCompile(`^[A-Z]{3}$`)

func (p LocalMoneyProps) expr() string {
	opts := "style: 'currency', currency: '" + p.checkedCurrency() + "'"
	if p.Digits != nil {
		if *p.Digits < 0 || *p.Digits > maxFractionDigits {
			panic("kit: LocalMoney: digits must be 0 to " + strconv.Itoa(maxFractionDigits))
		}
		opts += ", " + digitsOptions(*p.Digits)
	}
	return numberFormatExpr(opts, p.checkedAmount())
}

// LocalMoney is local-money.md: an amount in a currency, written by the browser
// in currency style in the page's language; the server-rendered text is
// "amount CODE".
templ LocalMoney(p LocalMoneyProps) {
	if p.Amount == "" {
		{ orDefault(p.Empty, "-") }
	} else {
		<data value={ p.checkedAmount() } data-currency={ p.checkedCurrency() } data-init={ p.expr() }><span data-ignore-morph>{ p.Amount + " " + p.Currency }</span></data>
	}
}

func (p LocalMoneyProps) checkedAmount() string {
	fractionDigits("LocalMoney", p.Amount)
	return p.Amount
}

func (p LocalMoneyProps) checkedCurrency() string {
	if !currencyCode.MatchString(p.Currency) {
		panic("kit: LocalMoney: " + strconv.Quote(p.Currency) + " is not a currency code (three capital letters)")
	}
	return p.Currency
}

// LocalQuantityProps mirrors local-quantity.md's Props table. The value and the
// unit symbol are plain strings, so the component depends on no units type.
type LocalQuantityProps struct {
	// Value is plain decimal text; empty renders Empty.
	Value string `json:"value"`
	// Unit is the unit symbol, shown after the number.
	Unit  string `json:"unit"`
	Empty string `json:"empty"`
}

// expr localises the number only: the unit is server text after the span, so a
// morph updates it like any other text.
func (p LocalQuantityProps) expr() string {
	return numberFormatExpr(digitsOptions(fractionDigits("LocalQuantity", p.Value)), p.Value)
}

// LocalQuantity is local-quantity.md: a measured value and its unit symbol; the
// browser writes the number in the page's language, the symbol follows.
templ LocalQuantity(p LocalQuantityProps) {
	if p.Value == "" {
		{ orDefault(p.Empty, "-") }
	} else if p.Unit == "" {
		<data value={ p.Value } data-init={ p.expr() }><span data-ignore-morph>{ p.Value }</span></data>
	} else {
		<data value={ p.Value } data-unit={ p.Unit } data-init={ p.expr() }><span data-ignore-morph>{ p.Value }</span>{ " " + p.Unit }</data>
	}
}

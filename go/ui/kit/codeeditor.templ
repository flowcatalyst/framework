package kit

// CodeEditorProps mirrors code-editor.md's Props table.
type CodeEditorProps struct {
	ID   string `json:"id"`
	Name string `json:"name"`
	// Value is the initial text.
	Value string `json:"value"`
	// Language is "json", "yaml" or empty (plain text).
	Language string `json:"language"`
	ReadOnly bool   `json:"readOnly"`
	// Label names the editor for assistive technology.
	Label string `json:"label"`
	Rows  int    `json:"rows"`
	// Invalid sets aria-invalid="true".
	Invalid     bool             `json:"invalid"`
	DescribedBy string           `json:"describedBy"`
	Class       string           `json:"class"`
	Attrs       templ.Attributes `json:"attrs"`
}

// CodeEditor is code-editor.md: a <textarea> that the <fc-code-editor>
// element (fc-code-editor.js, which the page loads) replaces with a
// CodeMirror editor that mirrors its text into a hidden input of the same
// name. Without the script the textarea is the control.
templ CodeEditor(p CodeEditorProps) {
	<fc-code-editor
		class={ cx("block", p.Class) }
		if p.Language != "" {
			language={ p.Language }
		}
		readonly?={ p.ReadOnly }
	>
		<textarea
			class={ textareaClasses + " font-mono" }
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Label != "" {
				aria-label={ p.Label }
			}
			if p.Rows > 0 {
				rows={ p.Rows }
			}
			readonly?={ p.ReadOnly }
			spellcheck="false"
			if p.Invalid {
				aria-invalid="true"
			}
			if p.DescribedBy != "" {
				aria-describedby={ p.DescribedBy }
			}
			{ Attrs(p.Attrs)... }
		>{ p.Value }</textarea>
	</fc-code-editor>
}

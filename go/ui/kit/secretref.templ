package kit

import (
	"strings"

	"github.com/flowcatalyst/framework/go/ui/i18n"
)

// SecretRefPattern is the HTML pattern of a secret reference: a lowercase,
// hyphen-separated name with an optional "store:" prefix naming the secret
// store that holds it.
const SecretRefPattern = "([a-z0-9]+(-[a-z0-9]+)*:)?[a-z0-9]+(-[a-z0-9]+)*"

// SecretRefInputProps mirrors secret-ref-input.md's Props table.
type SecretRefInputProps struct {
	ID          string `json:"id"`
	Name        string `json:"name"`
	Value       string `json:"value"`
	Placeholder string `json:"placeholder"`
	Required    bool   `json:"required"`
	Disabled    bool   `json:"disabled"`
	Invalid     bool   `json:"invalid"`
	// DescribedBy is the id of the error text (aria-describedby, after the help).
	DescribedBy string `json:"describedBy"`
	Class       string `json:"class"`
}

// SecretRefInput is secret-ref-input.md: a text field for the NAME of a
// secret (never its value), with the pattern check and the help that says so.
templ SecretRefInput(p SecretRefInputProps) {
	<div class={ cx("flex flex-col gap-2", p.Class) }>
		<input
			type="text"
			class={ inputClasses + " font-mono" }
			id={ ID(p.ID) }
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			placeholder={ orDefault(p.Placeholder, i18n.T(ctx, "kit.secretref.placeholder")) }
			pattern={ SecretRefPattern }
			title={ i18n.T(ctx, "kit.secretref.title") }
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			required?={ p.Required }
			disabled?={ p.Disabled }
			if p.Invalid {
				aria-invalid="true"
			}
			aria-describedby={ strings.TrimSpace(ID(p.ID) + "-help " + p.DescribedBy) }
		/>
		<p id={ ID(p.ID) + "-help" } class={ fieldDescClasses }>
			@secretRefHelp(ctx)
		</p>
	</div>
}

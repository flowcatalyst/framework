package kit

// DiagramProps mirrors diagram.md's Props table. The default slot is the
// Mermaid source (plain text, escaped by templ).
type DiagramProps struct {
	// Label names the diagram for assistive technology.
	Label string `json:"label"`
	// Bundle is the URL of the Mermaid bundle (assets.URL("mermaid.min.js")).
	Bundle string `json:"bundle"`
	Class  string `json:"class"`
}

// Diagram is diagram.md: Mermaid source drawn as an SVG by the <fc-diagram>
// element (fc-diagram.js, which the page loads), with the source kept below.
// The view is data-ignore: Datastar never evaluates attributes inside the
// drawing, which is built from author-controlled labels.
templ Diagram(p DiagramProps) {
	<fc-diagram class={ cx("block", p.Class) } data-bundle={ URL(p.Bundle) }>
		<div class="fc-diagram-view overflow-auto rounded-md border border-border bg-card p-4 [&_svg]:mx-auto [&_svg]:block [&_svg]:h-auto [&_svg]:max-w-full" role="img" aria-label={ p.Label } hidden data-ignore></div>
		<details class="mt-3 text-sm">
			<summary class="cursor-pointer text-muted-foreground">Diagram source</summary>
			<pre class="fc-code-block mt-2" tabindex="0" aria-label={ p.Label + " source" }>
				<code>
					{ children... }
				</code>
			</pre>
		</details>
	</fc-diagram>
}

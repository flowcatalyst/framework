package kit

import (
	"strings"

	"github.com/flowcatalyst/framework/go/ui/i18n"
)

// PasswordInputProps mirrors password-input.md's Props table.
type PasswordInputProps struct {
	ID   string `json:"id"`
	Name string `json:"name"`
	// Signal is the base of the two signals the control keeps:
	// {signal}Show (revealed) and {signal}Score (0-4). Camel-case, unique per page.
	Signal      string `json:"signal"`
	Placeholder string `json:"placeholder"`
	Required    bool   `json:"required"`
	Disabled    bool   `json:"disabled"`
	Invalid     bool   `json:"invalid"`
	// DescribedBy is the id of the error text (aria-describedby, after the strength line).
	DescribedBy string `json:"describedBy"`
	// Autocomplete is "new-password" (default) or "current-password".
	Autocomplete string `json:"autocomplete"`
	// Meter shows the strength meter (default off: a sign-in field has none).
	Meter bool   `json:"meter"`
	Class string `json:"class"`
}

// passwordScoreExpr is the advisory strength rule: under 8 characters is 1;
// from 8, one point for 12+ and 16+ characters and for each of mixed case, a
// digit and a symbol, capped at 4. The server's password policy decides.
func passwordScoreExpr(signal string) string {
	return "const v = el.value; $" + Signal(signal) + "Score = !v ? 0 : v.length < 8 ? 1 : Math.min(4, 1 + (v.length >= 12) + (v.length >= 16) + (/[a-z]/.test(v) && /[A-Z]/.test(v)) + /\\d/.test(v) + /[^A-Za-z0-9]/.test(v))"
}

func (p PasswordInputProps) signals() string {
	return "{" + Signal(p.Signal) + "Show: false, " + Signal(p.Signal) + "Score: 0}"
}

func (p PasswordInputProps) describedBy() string {
	if !p.Meter {
		return p.DescribedBy
	}
	return strings.TrimSpace(ID(p.ID) + "-strength " + p.DescribedBy)
}

func (p PasswordInputProps) inputAttrs() templ.Attributes {
	a := templ.Attributes{"data-attr:type": "$" + Signal(p.Signal) + "Show ? 'text' : 'password'"}
	if p.Meter {
		a["data-on:input"] = passwordScoreExpr(p.Signal)
	}
	return a
}

// PasswordInput is password-input.md: a password field with a show/hide
// toggle and an optional advisory strength meter.
templ PasswordInput(p PasswordInputProps) {
	<div class={ cx("fc-password", p.Class) } data-signals={ p.signals() }>
		<div class="relative">
			<input
				type="password"
				class={ inputClasses + " pr-10" }
				id={ ID(p.ID) }
				if p.Name != "" {
					name={ p.Name }
				}
				autocomplete={ orDefault(p.Autocomplete, "new-password") }
				if p.Placeholder != "" {
					placeholder={ p.Placeholder }
				}
				required?={ p.Required }
				disabled?={ p.Disabled }
				if p.Invalid {
					aria-invalid="true"
				}
				if p.describedBy() != "" {
					aria-describedby={ p.describedBy() }
				}
				{ Attrs(p.inputAttrs())... }
			/>
			<button
				type="button"
				class="fc-password-toggle"
				aria-label={ i18n.T(ctx, "kit.password.show") }
				aria-controls={ ID(p.ID) }
				disabled?={ p.Disabled }
				data-attr:aria-label={ "$" + Signal(p.Signal) + "Show ? " + jsq(i18n.T(ctx, "kit.password.hide")) + " : " + jsq(i18n.T(ctx, "kit.password.show")) }
				data-on:click={ "$" + Signal(p.Signal) + "Show = !$" + Signal(p.Signal) + "Show" }
			>
				<span data-show={ "!$" + Signal(p.Signal) + "Show" }>
					@Icon(IconProps{Name: "eye", Class: "size-4"})
				</span>
				<span data-show={ "$" + Signal(p.Signal) + "Show" } style="display: none">
					@Icon(IconProps{Name: "eye-off", Class: "size-4"})
				</span>
			</button>
		</div>
		if p.Meter {
			<div class="fc-password-meter" aria-hidden="true" data-score="0" data-attr:data-score={ "String($" + Signal(p.Signal) + "Score)" }>
				<span></span><span></span><span></span><span></span>
			</div>
			<p id={ ID(p.ID) + "-strength" } class="fc-password-strength" aria-live="polite" data-text={ "['', " + jsq(i18n.T(ctx, "kit.password.weak")) + ", " + jsq(i18n.T(ctx, "kit.password.fair")) + ", " + jsq(i18n.T(ctx, "kit.password.good")) + ", " + jsq(i18n.T(ctx, "kit.password.strong")) + "][$" + Signal(p.Signal) + "Score]" }></p>
			<p class="fc-password-help">{ i18n.T(ctx, "kit.password.help") }</p>
		}
	</div>
}

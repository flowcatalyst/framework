event: datastar-patch-elements
data: selector #flash-stack
data: mode append
data: elements <div class="fc-flash fc-flash-error" role="alert"><svg width="1em" height="1em" class="fc-flash-icon" aria-hidden="true"><use href="/fw-ui/lucide-sprite.svg#i-circle-x"></use></svg><div class="fc-flash-body"><span class="fc-flash-summary">Failed.</span> <span class="fc-flash-detail">Try again.</span></div><button type="button" class="fc-flash-dismiss" aria-label="Dismiss notification" data-on:click="el.parentElement.remove()"><svg width="1em" height="1em" class="size-[0.9rem]" aria-hidden="true"><use href="/fw-ui/lucide-sprite.svg#i-x"></use></svg></button></div>

event: datastar-patch-elements
data: selector #flash-stack
data: mode append
data: elements <div class="fc-flash fc-flash-success" data-init__delay.3s="el.remove()"><svg width="1em" height="1em" class="fc-flash-icon" aria-hidden="true"><use href="/fw-ui/lucide-sprite.svg#i-circle-check"></use></svg><div class="fc-flash-body"><span class="fc-flash-summary">Saved.</span> </div><button type="button" class="fc-flash-dismiss" aria-label="Dismiss notification" data-on:click="el.parentElement.remove()"><svg width="1em" height="1em" class="size-[0.9rem]" aria-hidden="true"><use href="/fw-ui/lucide-sprite.svg#i-x"></use></svg></button></div>


  "components": {
    "schemas": {
      "AdminAbout": {
        "type": "object",
        "properties": {
          "application": {
            "type": "string"
          },
          "framework": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ready": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminCheck"
            }
          }
        },
        "required": [
          "application",
          "environment",
          "startedAt",
          "ready",
          "checks"
        ],
        "additionalProperties": false
      },
      "AdminCheck": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN",
              "TIMED_OUT"
            ]
          },
          "critical": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "status",
          "critical"
        ],
        "additionalProperties": false
      },
      "AdminConfig": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "set": {
            "type": "integer",
            "format": "int32"
          },
          "defaulted": {
            "type": "integer",
            "format": "int32"
          },
          "unset": {
            "type": "integer",
            "format": "int32"
          },
          "settings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminConfigSetting"
            }
          },
          "health": {
            "$ref": "#/components/schemas/AdminHealth"
          }
        },
        "required": [
          "environment",
          "total",
          "set",
          "defaulted",
          "unset",
          "settings",
          "health"
        ],
        "additionalProperties": false
      },
      "AdminConfigSetting": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "secret": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "SET",
              "DEFAULT",
              "UNSET"
            ]
          },
          "source": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "withheld": {

  <artifactId>framework-partitions-admin</artifactId>
  <name>framework-partitions-admin</name>
  <description>The partitions section of the application admin: operators-only operations over the partitions module (status, archives, run a pass, ensure a range).</description>

  <!--
    A module of its own, like framework-locks-database and framework-auth-database: framework-admin
    must not depend on framework-partitions (the admin skeleton is HTTP-only), and framework-partitions
    needs neither HTTP nor the admin registry. An application that wants the section lists this module.
  -->
  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-http</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-admin</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-partitions</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-database</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-locks</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-objectstore</artifactId>

          "error" : "FORBIDDEN"
        }
      }
    },
    "expect" : {
      "status" : 502,
      "calls" : [ "GET /api/events" ],
      "error" : "PLATFORM_ERROR",
      "message" : "the platform refused this read for the application's service account; it needs the platform's view permission for this resource"

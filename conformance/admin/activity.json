      "dataTruncated" : false,
      "dispatchJobs" : [ "dj_1" ]
    }
  }, {
    "name" : "another application's event",
    "method" : "GET",
    "path" : "/api/admin/events/ev_other",
    "permissions" : [ "orders:admin:activity:view" ],
    "expect" : {
      "status" : 404,
      "calls" : [ "GET /api/events/ev_other" ],
      "error" : "EVENT_NOT_FOUND",
      "message" : "there is no such event"
    }
  }, {
    "name" : "an event id that could change the path",

  "cases" : [ {
    "name" : "events, this application's only",
    "method" : "GET",
    "path" : "/api/admin/events",
    "permissions" : [ "orders:admin:activity:view" ],
    "expect" : {
      "status" : 200,
      "calls" : [ "GET /api/events" ],
      "answerHasLink" : false,
      "items" : [ "ev_2", "ev_1" ],
      "nextCursor" : null
    }
  }, {
    "name" : "events, a page with a next",
    "method" : "GET",
    "path" : "/api/admin/events?limit=2&after=4",
    "permissions" : [ "orders:admin:activity:view" ],
    "expect" : {
      "status" : 200,
      "calls" : [ "GET /api/events" ],
      "answerHasLink" : false,
      "items" : [ "ev_2", "ev_1" ],
      "nextCursor" : "6"
    }
  }, {

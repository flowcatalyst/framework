    }
  }, {
    "name" : "PLATFORM_UNAVAILABLE: Accept json",
    "condition" : "PLATFORM_UNAVAILABLE",
    "request" : {
      "method" : "GET",
      "path" : "/auth/login",
      "headers" : {
        "Accept" : "application/json"
      }
    },
    "expect" : {

      "error" : "PLATFORM_UNAVAILABLE"
    }
  }, {
    "name" : "PLATFORM_UNAVAILABLE: Authorization present",
    "condition" : "PLATFORM_UNAVAILABLE",
    "request" : {
      "method" : "GET",
      "path" : "/auth/login",
      "headers" : {
        "Sec-Fetch-Mode" : "navigate",
        "Authorization" : "Bearer x"
      }
    },
    "expect" : {
      "status" : 502,
      "error" : "PLATFORM_UNAVAILABLE"
    }
  }, {
    "name" : "RATE_LIMITED: callback navigation",
    "condition" : "RATE_LIMITED",
    "request" : {
      "method" : "GET",
      "path" : "/auth/callback?state=x",
      "headers" : {
        "Sec-Fetch-Mode" : "navigate"
      }
    },
    "expect" : {
      "status" : 302,
      "location" : "/sign-in-failed?error=RATE_LIMITED"
    }
  }, {
    "name" : "RATE_LIMITED: callback fetch",
    "condition" : "RATE_LIMITED",
    "request" : {
      "method" : "GET",
      "path" : "/auth/callback?state=x",
      "headers" : {
        "Sec-Fetch-Mode" : "cors"
      }
    },
    "expect" : {
      "status" : 429,
      "error" : "RATE_LIMITED"
    }
  } ]

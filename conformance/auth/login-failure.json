    "request" : {
      "method" : "GET",
      "path" : "/auth/login?returnTo=%2Forders",
      "headers" : {
        "Sec-Fetch-Mode" : "navigate"
      }
    },
    "expect" : {
      "status" : 302,
      "location" : "/sign-in-failed?error=PLATFORM_UNAVAILABLE"
    }
  }, {
    "name" : "PLATFORM_UNAVAILABLE: fetch (cors) even when Accept html",

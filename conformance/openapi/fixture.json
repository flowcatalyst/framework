  "components": {
    "schemas": {
      "Collections": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counts": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "colours": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "RED",
                "GREEN",
                "BLUE"
              ]
            },
            "uniqueItems": true
          },
          "totals": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "groups": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "tags",
          "counts",
          "colours",
          "totals",
          "lines",
          "groups"
        ],
        "additionalProperties": false
      },
      "CursorPageWidget": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Widget"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "hasMore"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "error",
          "message"
        ],
        "additionalProperties": false
      },
      "Ids": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$"
          },
          "principal": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1
          },
          "application": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "correlation": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1
          }
        },
        "required": [
          "client",
          "principal",
          "application",
          "correlation"
        ],
        "additionalProperties": false
      },
      "Line": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": false
      },
      "NoteBody": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      },
      "Pong": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "at"
        ],
        "additionalProperties": false
      },
      "Scalars": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "flag": {
            "type": "boolean"
          },
          "maybeFlag": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "maybeCount": {
            "type": "integer",
            "format": "int32"
          },
          "big": {
            "type": "integer",
            "format": "int64"
          },
          "maybeBig": {
            "type": "integer",
            "format": "int64"
          },
          "ratio": {
            "type": "number",
            "format": "double"
          },
          "maybeRatio": {
            "type": "number",
            "format": "double"
          },
          "amount": {
            "type": "string",
            "format": "decimal"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "timeout": {
            "type": "string",
            "format": "duration"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "blob": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "anything": {},
          "colour": {
            "type": "string",
            "enum": [
              "RED",
              "GREEN",
              "BLUE"
            ]
          },
          "price": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "an amount with two decimals"
          }
        },
        "required": [
          "text",
          "flag",
          "count",
          "big",
          "ratio",
          "amount",
          "at",
          "day",
          "timeout",
          "uuid",
          "blob",
          "anything",
          "colour",
          "price"
        ],
        "additionalProperties": false
      },
      "Shape": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ShapeCircle"
          },
          {
            "$ref": "#/components/schemas/ShapeSquare"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "circle": "#/components/schemas/ShapeCircle",
            "square": "#/components/schemas/ShapeSquare"
          }
        }
      },
      "ShapeCircle": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "circle"
          },
          "radius": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "kind",
          "radius"
        ],
        "additionalProperties": false
      },
      "ShapeSquare": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "square"
          },
          "side": {
            "type": "number",
            "format": "double"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "side"
        ],
        "additionalProperties": false
      },
      "Widget": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "scalars": {
            "$ref": "#/components/schemas/Scalars"
          },
          "ids": {
            "$ref": "#/components/schemas/Ids"
          },
          "collections": {
            "$ref": "#/components/schemas/Collections"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "shape",
          "scalars",
          "ids",
          "collections"
        ],
        "additionalProperties": false
      },
      "WidgetBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1,
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "pattern": "^(?:[A-Z][A-Z0-9-]*)$",
            "minLength": 3,
            "maxLength": 12
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 1000
          },
          "ratio": {
            "type": "number",
            "format": "double",
            "minimum": 0.5,
            "maximum": 2.5
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20
            },
            "minItems": 1,
            "maxItems": 5
          },
          "colour": {
            "type": "string",
            "enum": [
              "red",
              "green"
            ]
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "line": {
            "$ref": "#/components/schemas/Line"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "free": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "code",
          "quantity",
          "ratio",
          "tags",
          "colour",
          "shape",
          "line",
          "lines",
          "free"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fw_session"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "basic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "tags": [
    {
      "name": "shapes"
    },
    {
      "name": "widgets"
    }
  ]
}

          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          },
          {
            "basic": []
          }
        ]
      }
    },
    "/api/ping": {
      "post": {
        "operationId": "ping",
        "summary": "Answer at once",
        "description": "A public operation without a body or parameters: only the default response.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {

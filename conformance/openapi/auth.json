{
  "openapi": "3.1.0",
  "info": {
    "title": "flowcatalyst-auth",
    "version": "1"
  },
  "paths": {
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Sign out of the application",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthLogout"
                }
              }
            }
          },
          "403": {
            "description": "CROSS_ORIGIN_REQUEST: the request did not come from this application's pages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE: a request body must be JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "summary": "Read the browser session",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthCsrf": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "const": "fetch-metadata"
          },
          "jsonBodies": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "mode",
          "jsonBodies"
        ],
        "additionalProperties": false
      },
      "AuthLogout": {
        "type": "object",
        "properties": {
          "loggedOut": {
            "type": "boolean",
            "const": true
          },
          "endSessionUrl": {
            "type": "string"
          }
        },
        "required": [
          "loggedOut"
        ],
        "additionalProperties": false
      },
      "AuthPrincipal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "USER",
              "SERVICE"
            ]
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      },
      "AuthSession": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AuthSessionAuthenticated"
          },
          {
            "$ref": "#/components/schemas/AuthSessionAnonymous"
          }
        ]
      },
      "AuthSessionAnonymous": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": false
          },
          "loginUrl": {
            "type": "string"
          }
        },
        "required": [
          "authenticated",
          "loginUrl"
        ],
        "additionalProperties": false
      },
      "AuthSessionAuthenticated": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": true
          },
          "principal": {
            "$ref": "#/components/schemas/AuthPrincipal"
          },
          "tier": {
            "type": "string",
            "enum": [
              "ANCHOR",
              "PARTNER",
              "CLIENT"
            ]
          },
          "client": {
            "type": "string"
          },
          "clients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authTime": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "csrf": {
            "$ref": "#/components/schemas/AuthCsrf"
          }
        },
        "required": [
          "authenticated",
          "principal",
          "client",
          "clients",
          "applications",
          "roles",
          "permissions",
          "authTime",
          "expiresAt",
          "idleExpiresAt",
          "csrf"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "error",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fw_session"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "auth"
    }
  ]
}

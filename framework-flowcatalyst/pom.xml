<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flowcatalyst.framework</groupId>
    <artifactId>framework-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>framework-flowcatalyst</artifactId>
  <name>framework-flowcatalyst</name>
  <description>The FlowCatalyst platform client, definition sync, the outbox health check and the receivers. The only module that imports the SDK.</description>

  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-database</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-http</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-locks</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-database</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- The outbox table for the outbox health check's tests (framework-http no longer brings it). -->
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-usecase</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The scheduled-job overlap lock end to end on the PostgreSQL lock driver. -->
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-locks-database</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The in-process fake platform is shared with the tests of later modules. -->
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

{
  "openapi": "3.1.0",
  "info": {
    "title": "orders-demo",
    "version": "1"
  },
  "paths": {
    "/api/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List the client's orders",
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOrderSummaryView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "x-fw-permission": "orders:order:read"
      },
      "post": {
        "operationId": "placeOrder",
        "summary": "Place an order",
        "tags": [
          "orders"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrderBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "x-fw-permission": "orders:order:manage"
      }
    },
    "/api/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Read an order",
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: there is no such order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "x-fw-permission": "orders:order:read"
      }
    },
    "/api/orders/{orderId}/cancel": {
      "post": {
        "operationId": "cancelOrder",
        "summary": "Cancel an open order",
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelOrderBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: there is no such order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "ORDER_NOT_OPEN: the order is already cancelled\nSTALE_AGGREGATE: the order was changed by someone else; reload it and try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "x-fw-permission": "orders:order:manage"
      }
    },
    "/api/orders/{orderId}/lines": {
      "post": {
        "operationId": "addOrderLine",
        "summary": "Add a line to an open order",
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddLineBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: there is no such order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "ORDER_NOT_OPEN: the order is cancelled and cannot change\nSTALE_AGGREGATE: the order was changed by someone else; reload it and try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "x-fw-permission": "orders:order:manage"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Sign out of the application",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthLogout"
                }
              }
            }
          },
          "403": {
            "description": "CROSS_ORIGIN_REQUEST: the request did not come from this application's pages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE: a request body must be JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "summary": "Read the browser session",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddLineBody": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^(?:[A-Z0-9][A-Z0-9-]*)$",
            "minLength": 1,
            "maxLength": 64
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 10000
          },
          "unitPriceCents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "required": [
          "sku",
          "quantity",
          "unitPriceCents"
        ],
        "additionalProperties": false
      },
      "AuthCsrf": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "const": "fetch-metadata"
          },
          "jsonBodies": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "mode",
          "jsonBodies"
        ],
        "additionalProperties": false
      },
      "AuthLogout": {
        "type": "object",
        "properties": {
          "loggedOut": {
            "type": "boolean",
            "const": true
          },
          "endSessionUrl": {
            "type": "string"
          }
        },
        "required": [
          "loggedOut"
        ],
        "additionalProperties": false
      },
      "AuthPrincipal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "USER",
              "SERVICE"
            ]
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      },
      "AuthSession": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AuthSessionAuthenticated"
          },
          {
            "$ref": "#/components/schemas/AuthSessionAnonymous"
          }
        ]
      },
      "AuthSessionAnonymous": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": false
          },
          "loginUrl": {
            "type": "string"
          }
        },
        "required": [
          "authenticated",
          "loginUrl"
        ],
        "additionalProperties": false
      },
      "AuthSessionAuthenticated": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": true
          },
          "principal": {
            "$ref": "#/components/schemas/AuthPrincipal"
          },
          "tier": {
            "type": "string",
            "enum": [
              "ANCHOR",
              "PARTNER",
              "CLIENT"
            ]
          },
          "client": {
            "type": "string"
          },
          "clients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authTime": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "csrf": {
            "$ref": "#/components/schemas/AuthCsrf"
          }
        },
        "required": [
          "authenticated",
          "principal",
          "client",
          "clients",
          "applications",
          "roles",
          "permissions",
          "authTime",
          "expiresAt",
          "idleExpiresAt",
          "csrf"
        ],
        "additionalProperties": false
      },
      "CancelOrderBody": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "error",
          "message"
        ],
        "additionalProperties": false
      },
      "OrderLineView": {
        "type": "object",
        "properties": {
          "lineId": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPriceCents": {
            "type": "integer",
            "format": "int64"
          },
          "totalCents": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "lineId",
          "sku",
          "quantity",
          "unitPriceCents",
          "totalCents"
        ],
        "additionalProperties": false
      },
      "OrderSummaryView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "CANCELLED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "lineCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalCents": {
            "type": "integer",
            "format": "int64"
          },
          "firstSku": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "customer",
          "status",
          "version",
          "lineCount",
          "totalCents"
        ],
        "additionalProperties": false
      },
      "OrderView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "CANCELLED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineView"
            }
          },
          "totalCents": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "customer",
          "status",
          "version",
          "lines",
          "totalCents"
        ],
        "additionalProperties": false
      },
      "PageOrderSummaryView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSummaryView"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "PlaceOrderBody": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "customer"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fw_session"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "orders"
    }
  ]
}

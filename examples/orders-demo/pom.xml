<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flowcatalyst.framework</groupId>
    <artifactId>framework-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>orders-demo</artifactId>
  <name>orders-demo</name>
  <description>An order with lines: the write path end to end (use cases, optimistic locking, outbox).</description>

  <properties>
    <!-- An example: never published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-usecase</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-database</artifactId>
    </dependency>
    <!-- An application chooses its logging backend; libraries bring none. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-database</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Checked SQL: src/main/sql/**/*.sql is described against the migrated schema and the typed
        Java in src/main/java-generated is committed. add-source puts that directory on the
        compile path; check (in verify) fails when the committed code is stale. The migration sets
        are the ones the application applies, in the order it applies them.
      -->
      <plugin>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-sql-maven-plugin</artifactId>
        <version>${project.version}</version>
        <configuration>
          <migrations>
            <migration>
              <moduleId>outbox</moduleId>
              <location>db/migration/outbox</location>
            </migration>
            <migration>
              <moduleId>orders</moduleId>
              <location>db/migration/orders</location>
            </migration>
          </migrations>
        </configuration>
        <executions>
          <execution>
            <id>add-generated-source</id>
            <goals>
              <goal>add-source</goal>
            </goals>
          </execution>
          <execution>
            <id>check-sql</id>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ./mvnw -Pgenerate-sql -DskipTests package -pl examples/orders-demo -am -->
    <profile>
      <id>generate-sql</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.flowcatalyst.framework</groupId>
            <artifactId>framework-sql-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>generate-sql</id>
                <goals>
                  <goal>generate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

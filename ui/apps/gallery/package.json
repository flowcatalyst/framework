{
  "name": "@flowcatalyst/gallery",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --build tsconfig.node.json && vue-tsc --build tsconfig.app.json",
    "serve:csp": "node scripts/serve-csp.ts",
    "e2e": "vite build && playwright test",
    "generate": "openapi-ts",
    "drift": "openapi-ts && node ../../scripts/api-drift.ts src/api",
    "screenshots": "vite build && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "screenshots:fonts": "vite build --mode fonts && playwright test --config playwright.fonts.config.ts"
  },
  "dependencies": {
    "@flowcatalyst/api-runtime": "workspace:*",
    "@flowcatalyst/ui": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@iconify-json/lucide": "catalog:",
    "@internationalized/date": "catalog:",
    "@nuxt/ui": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@hey-api/openapi-ts": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}

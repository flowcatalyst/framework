{
  "$comment": "Node: the Vite and Playwright configs, the CSP test server and the e2e specs.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "openapi-ts.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "e2e-fonts/**/*.ts",
    "playwright.fonts.config.ts",
    "src/pages.ts",
    "src/font-list.ts",
    "src/behaviours.ts"
  ]
}

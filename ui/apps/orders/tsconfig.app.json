{
  "$comment": "Browser source. #build/ui is written by Nuxt UI's Vite plugin (pnpm build runs it first).",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "#build/ui": ["./node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/api/*/client/**", "src/api/*/core/**"],
  "references": [{ "path": "./tsconfig.generated.json" }, { "path": "../../packages/api-runtime/tsconfig.generated.json" }]
}

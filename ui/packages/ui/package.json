{
  "name": "@flowcatalyst/ui",
  "version": "0.0.0",
  "private": true,
  "description": "FlowCatalyst framework UI: Nuxt UI v4 on Vue 3 and Vite, shipped as TypeScript and Vue source",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./csp": "./src/csp.ts",
    "./theme": "./src/theme/index.ts",
    "./theme.css": "./src/theme/theme.css",
    "./vite": "./src/vite.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.generated-client.json": "./tsconfig.generated-client.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "tsconfig.generated-client.json"
  ],
  "scripts": {
    "build": "node scripts/nuxt-ui-types.ts",
    "typecheck": "tsc --build tsconfig.node.json && vue-tsc --build tsconfig.app.json tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nuxt/ui": "4.11.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@flowcatalyst/api-runtime": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@vueuse/core": "catalog:",
    "reka-ui": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  }
}

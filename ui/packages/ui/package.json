{
  "name": "@flowcatalyst/ui",
  "version": "0.0.0",
  "private": true,
  "description": "FlowCatalyst framework UI: Nuxt UI v4 on Vue 3 and Vite, shipped as TypeScript and Vue source",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./csp": "./src/csp.ts",
    "./theme": "./src/theme/index.ts",
    "./theme/kit.css": "./src/theme/kit.css",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node scripts/nuxt-ui-types.ts",
    "typecheck": "vue-tsc --build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nuxt/ui": "4.11.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@flowcatalyst/api-runtime": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@vueuse/core": "catalog:",
    "reka-ui": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  }
}

{
  "name": "@flowcatalyst/ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "gallery:dev": "pnpm --filter @flowcatalyst/gallery dev",
    "gallery:e2e": "pnpm --filter @flowcatalyst/gallery e2e",
    "api:drift": "pnpm -r --if-present drift",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm api:drift && pnpm licences && pnpm gallery:e2e",
    "licences": "node scripts/check-licences.ts",
    "licences:write": "node scripts/check-licences.ts --write",
    "gallery:screenshots": "pnpm --filter @flowcatalyst/gallery screenshots"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1",
    "vue-eslint-parser": "10.4.1"
  }
}

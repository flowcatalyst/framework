{
  "$comment": "Workspace tooling (the ESLint config, the licence check).",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tools.tsbuildinfo",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "eslint.config.ts",
    "scripts/**/*.ts"
  ]
}

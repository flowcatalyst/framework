<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flowcatalyst.framework</groupId>
    <artifactId>framework-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>framework-admin</artifactId>
  <name>framework-admin</name>
  <description>The application admin skeleton (M4d): a registry of admin sections, permission gating, and the navigation and about operations. Data sections are M4e.</description>

  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-http</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- the conformance vector helper (Conformance) -->
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- An admin area must not bring the write path or a database to an HTTP-only application. -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

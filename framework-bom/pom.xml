<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The bill of materials: the version of every framework artifact and of every library they are
    built and tested with. An application imports it (scope import) and lists framework modules
    without versions. framework-parent imports it too, so this file is the one place versions live.

    No parent on purpose: a BOM that inherited framework-parent would hand its build configuration
    (Error Prone, NullAway) to nobody, but its own version would come from the parent; keeping it
    stand-alone makes what an application imports exactly this file. The version is literal; release
    with versions:set -DprocessAllModules=true so it moves with the rest (docs/contracts/build.md).
  -->
  <groupId>io.flowcatalyst.framework</groupId>
  <artifactId>framework-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>framework-bom</name>
  <description>Application framework for business services: bill of materials.</description>
  <url>https://github.com/flowcatalyst/framework</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/flowcatalyst/framework</url>
    <connection>scm:git:https://github.com/flowcatalyst/framework.git</connection>
    <developerConnection>scm:git:git@github.com:flowcatalyst/framework.git</developerConnection>
  </scm>

  <!-- GitHub Packages; same as framework-parent's (this module does not inherit it). -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages: flowcatalyst/framework</name>
      <url>https://maven.pkg.github.com/flowcatalyst/framework</url>
    </repository>
  </distributionManagement>

  <properties>
    <project.build.outputTimestamp>2026-10-08T00:00:00Z</project.build.outputTimestamp>

    <!-- libraries the framework artifacts depend on -->
    <jspecify.version>1.0.1</jspecify.version>
    <slf4j.version>2.0.20</slf4j.version>
    <snakeyaml-engine.version>3.2</snakeyaml-engine.version>
    <hikaricp.version>7.1.0</hikaricp.version>
    <postgresql.version>42.7.14</postgresql.version>
    <jedis.version>8.0.2</jedis.version>
    <jackson.version>3.2.3</jackson.version>
    <jetty.version>12.1.12</jetty.version>
    <flowcatalyst-sdk.version>0.0.11</flowcatalyst-sdk.version>
    <vertx.version>5.1.7</vertx.version>

    <!-- test stack the published test-jars (fixtures, contract suites) are compiled against -->
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-database</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-database</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-redis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-redis</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks-database</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-locks-redis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-usecase</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-http</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-http-jetty</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-sql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-ratelimit-redis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-httpclient</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-httpclient-module</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-flowcatalyst</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.flowcatalyst.framework</groupId>
        <artifactId>framework-flowcatalyst</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.snakeyaml</groupId>
        <artifactId>snakeyaml-engine</artifactId>
        <version>${snakeyaml-engine.version}</version>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${hikaricp.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>redis.clients</groupId>
        <artifactId>jedis</artifactId>
        <version>${jedis.version}</version>
      </dependency>

      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <!-- The HTTP client's engine (contracts/http-client.md section 1). -->
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-core</artifactId>
        <version>${vertx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-server</artifactId>
        <version>${jetty.version}</version>
      </dependency>
      <!-- The FlowCatalyst SDK. Compile dependency of framework-flowcatalyst only; framework-usecase
           uses it in test scope, to prove outbox payloads are what it writes. -->
      <dependency>
        <groupId>io.flowcatalyst</groupId>
        <artifactId>flowcatalyst-sdk</artifactId>
        <version>${flowcatalyst-sdk.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
